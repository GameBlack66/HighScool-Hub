<!DOCTYPE html>

<html class="light" lang="fr"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>HighSchool Hub - Accueil</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&amp;family=Plus+Jakarta+Sans:wght@400;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "primary-fixed": "#dbe1ff",
                      "on-secondary": "#ffffff",
                      "surface-container": "#eaedff",
                      "on-background": "#131b2e",
                      "outline": "#737686",
                      "surface-variant": "#dae2fd",
                      "on-secondary-container": "#fffbff",
                      "on-tertiary-fixed": "#3d0026",
                      "tertiary-container": "#b74082",
                      "tertiary-fixed-dim": "#ffafd3",
                      "background": "#faf8ff",
                      "surface-container-lowest": "#ffffff",
                      "surface-dim": "#d2d9f4",
                      "on-tertiary-fixed-variant": "#85145a",
                      "surface-container-low": "#f2f3ff",
                      "on-tertiary-container": "#ffecf1",
                      "on-surface": "#131b2e",
                      "tertiary": "#982669",
                      "surface-container-high": "#e2e7ff",
                      "on-error-container": "#93000a",
                      "on-tertiary": "#ffffff",
                      "primary-fixed-dim": "#b4c5ff",
                      "inverse-surface": "#283044",
                      "primary": "#004ac6",
                      "surface": "#faf8ff",
                      "surface-container-highest": "#dae2fd",
                      "primary-container": "#2563eb",
                      "surface-tint": "#0053db",
                      "on-secondary-fixed": "#23005c",
                      "inverse-on-surface": "#eef0ff",
                      "on-secondary-fixed-variant": "#5516be",
                      "error-container": "#ffdad6",
                      "on-primary-fixed": "#00174b",
                      "secondary-fixed-dim": "#d0bcff",
                      "inverse-primary": "#b4c5ff",
                      "error": "#ba1a1a",
                      "secondary": "#6b38d4",
                      "on-surface-variant": "#434655",
                      "outline-variant": "#c3c6d7",
                      "tertiary-fixed": "#ffd8e7",
                      "on-primary": "#ffffff",
                      "secondary-fixed": "#e9ddff",
                      "on-error": "#ffffff",
                      "on-primary-fixed-variant": "#003ea8",
                      "secondary-container": "#8455ef",
                      "on-primary-container": "#eeefff",
                      "surface-bright": "#faf8ff"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "lg": "48px",
                      "gutter": "24px",
                      "base": "8px",
                      "sm": "12px",
                      "xl": "80px",
                      "margin": "24px",
                      "md": "24px",
                      "xs": "4px"
              },
              "fontFamily": {
                      "headline-lg": ["Montserrat"],
                      "headline-md": ["Montserrat"],
                      "headline-xl": ["Montserrat"],
                      "headline-xl-mobile": ["Montserrat"],
                      "label-md": ["Plus Jakarta Sans"],
                      "body-md": ["Plus Jakarta Sans"],
                      "headline-lg-mobile": ["Montserrat"],
                      "body-lg": ["Plus Jakarta Sans"]
              },
              "fontSize": {
                      "headline-lg": ["32px", {"lineHeight": "1.2", "fontWeight": "700"}],
                      "headline-md": ["24px", {"lineHeight": "1.3", "fontWeight": "700"}],
                      "headline-xl": ["48px", {"lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "800"}],
                      "headline-xl-mobile": ["32px", {"lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "800"}],
                      "label-md": ["14px", {"lineHeight": "1.4", "letterSpacing": "0.05em", "fontWeight": "600"}],
                      "body-md": ["16px", {"lineHeight": "1.6", "fontWeight": "400"}],
                      "headline-lg-mobile": ["24px", {"lineHeight": "1.2", "fontWeight": "700"}],
                      "body-lg": ["18px", {"lineHeight": "1.6", "fontWeight": "400"}]
              }
            },
          },
        }
    </script>
<style>
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .glass-effect { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); }
        .premium-gradient { background: linear-gradient(135deg, #004ac6 0%, #6b38d4 100%); }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background text-on-surface font-body-md min-h-screen pb-24">
<!-- TopAppBar -->
<header class="w-full top-0 sticky z-50 bg-surface dark:bg-on-background shadow-sm dark:shadow-none h-16 flex justify-between items-center px-margin">
<div class="flex items-center gap-3 active:scale-95 transition-transform duration-200">
<div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center overflow-hidden border-2 border-primary">
<img alt="Avatar" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBz_YlYSZfnoWyR_hqhlFC2seoj9llDE4VI-yiaUUiHTl_-lUg3Ok4arPWEZF-gvD8qJahuSJGG7Kws8TsQ25B5s6lXcZ2R7GX_GI5veX7NP_QDy6Y7D6FSOpi5E6ropwfDipVYPLAFEw7KeiYYQsVPLucyVc2ShhDlOE9PPp3eL1pPGQ2fVTH8ltYAmkUbjYdaLC39MD2MPCvE8MKgRHQgCiJd7ryqD4oxHAlsGaJfSYecLdmH6jSwaUQJHTSpciXcZE0Hzbt5qSq3"/>
</div>
<span class="font-headline-lg-mobile text-headline-lg-mobile text-primary dark:text-primary-fixed tracking-tight">HighSchool Hub</span>
</div>
<button class="w-10 h-10 flex items-center justify-center text-primary dark:text-primary-fixed hover:opacity-80 transition-opacity active:scale-95 duration-200">
<span class="material-symbols-outlined" data-icon="notifications">notifications</span>
</button>
</header>
<main class="max-w-7xl mx-auto px-margin pt-6 space-y-md">
<!-- Hero: Featured Game -->
<section class="relative group cursor-pointer overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-xl active:scale-[0.98]">
<div class="aspect-[16/9] md:aspect-[21/9] w-full relative">
<img alt="Jeu à la une" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" data-alt="A cinematic, high-energy gaming scene featuring stylized futuristic characters in a neon-lit arena. The aesthetic is modern and vibrant with deep primary blues and electric purples. The lighting is dramatic and high-contrast, reflecting the optimistic and competitive spirit of an elite high school esports tournament. Soft ambient shadows provide a sense of depth against a clean digital background." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBuMrK2wVIOT7bSOawdsjj100ahc1LVm-meAAd5mZYe4BT8bHMLMPZO2VIeDrcH3-gS8bb61zokjoF-1wnCsWasKFaDBtTevJbOYQ0tKrO9lCT2OS89lIM4Su9hte2Frh_Ci6RFwXZjrY7PEDNy0hSe76AFgSO52vnrKEtJSBWu2XSj7qYX8XhmS9N9WWo4bTBIXdntaLW1slg0-UDbbJHQVJxhsoN0kIJaqe-YsGQk6yP-R-x0ZWgT4F3F9IhIr7IigdHhw-vA-G_G"/>
<div class="absolute inset-0 bg-gradient-to-t from-on-background/80 via-transparent to-transparent"></div>
<div class="absolute bottom-0 left-0 p-md space-y-2">
<span class="inline-block px-3 py-1 bg-tertiary text-white rounded-full font-label-md text-xs uppercase tracking-wider">Jeu Vedette</span>
<h2 class="font-headline-xl-mobile text-white">Cyber Académie : Le Duel</h2>
<p class="text-white/80 font-body-md max-w-lg hidden md:block">Préparez-vous pour le tournoi inter-lycées le plus épique de l'année. Grimpez dans le classement maintenant !</p>
<button class="mt-2 bg-primary text-white px-6 py-2 rounded-full font-label-md flex items-center gap-2 hover:bg-primary-container transition-colors shadow-lg">
<span class="material-symbols-outlined" data-icon="sports_esports">sports_esports</span>
                        Jouer Maintenant
                    </button>
</div>
</div>
</section>
<!-- School Event Countdown -->
<section class="bg-surface-container-high rounded-xl p-md flex flex-col md:flex-row justify-between items-center gap-4">
<div class="space-y-1 text-center md:text-left">
<h3 class="font-headline-md text-on-surface">Compte à rebours : Bal de Promo</h3>
<p class="text-on-surface-variant font-body-md">Le moment le plus attendu de l'année scolaire !</p>
</div>
<div class="flex gap-4">
<div class="flex flex-col items-center">
<span class="text-headline-md font-headline-md text-primary" id="days">14</span>
<span class="text-[10px] uppercase font-bold text-outline">Jours</span>
</div>
<div class="text-headline-md font-headline-md text-primary-fixed-dim">:</div>
<div class="flex flex-col items-center">
<span class="text-headline-md font-headline-md text-primary" id="hours">08</span>
<span class="text-[10px] uppercase font-bold text-outline">Heures</span>
</div>
<div class="text-headline-md font-headline-md text-primary-fixed-dim">:</div>
<div class="flex flex-col items-center">
<span class="text-headline-md font-headline-md text-primary" id="mins">42</span>
<span class="text-[10px] uppercase font-bold text-outline">Mins</span>
</div>
</div>
</section>
<!-- Quick News Section -->
<section class="space-y-sm">
<div class="flex justify-between items-end">
<h3 class="font-headline-md text-on-surface">Actualités Rapides</h3>
<button class="text-primary font-label-md hover:underline">Tout voir</button>
</div>
<div class="flex gap-md overflow-x-auto no-scrollbar pb-4 -mx-margin px-margin snap-x">
<!-- News Card 1 -->
<div class="min-w-[280px] md:min-w-[340px] snap-start group cursor-pointer bg-white rounded-xl shadow-sm hover:shadow-md transition-all">
<div class="aspect-video w-full rounded-t-xl overflow-hidden">
<img alt="Sport" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" data-alt="A vibrant high school sports field under golden hour sunlight. Students in modern athletic gear are cheering and celebrating a victory. The atmosphere is energetic and joyful, captured with a shallow depth of field. The color palette emphasizes rich greens and warm oranges, maintaining the modern, app-like visual style of the platform." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBxHF7_JfHX3K1l7ynH3agX7CiKdh52kqq7LK1X7E2zUfwUeRgMDs4rKHmfTVnZhtFCqlbqHjF9k4c2Cz5dm6dOyCnEPXzRmjalZgH6FQKWL8pODx3LLjzuOfTHsKc6S8ZlihfNCX09qyOvMS6QXywT4ErDtcyKCZCwPJKvn-wkaSjOEqP40nKPIkTDIsqv_QY-6uzSQL3r6mGJdzjeaodnoX0XaLaoLEoNyPp8aP72L_FDMNooNX62dNFDNdTYvwHHlaUjVwQ2B8og"/>
</div>
<div class="p-sm space-y-2">
<div class="flex items-center gap-2">
<span class="bg-primary-fixed text-on-primary-fixed-variant px-2 py-0.5 rounded text-[10px] font-bold uppercase">Sports</span>
<span class="text-outline text-xs">Il y a 2h</span>
</div>
<h4 class="font-headline-md text-base leading-tight group-hover:text-primary transition-colors">Victoire écrasante de l'équipe de basket !</h4>
</div>
</div>
<!-- News Card 2 -->
<div class="min-w-[280px] md:min-w-[340px] snap-start group cursor-pointer bg-white rounded-xl shadow-sm hover:shadow-md transition-all">
<div class="aspect-video w-full rounded-t-xl overflow-hidden">
<img alt="Culture" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" data-alt="A modern art studio in a high school setting, filled with colorful canvases and creative student work. Soft morning light enters through large windows, creating a bright and inspiring workspace. The style is clean and sophisticated, using a palette of soft pastels and primary accents to reflect the platform's artistic and youthful energy." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCmC_KQFYw6B5MdfKLZ3Ffs8kOqI6GQqkKDgZZ0grt2z5Vs67EaKB1NVbL8DfBtPcfrFAIyA4ARwwoIo361Fdh3W6oIyT3RgxK2xej5NBTbvpz4dP4YZf6FyrJ2WttS0Lexg-QsxBECMOlkCjuEavwn2rJAbcTMAQig_RMx2st5n9GI2FUowVtvuMSfPbiydzjP4Inta58QFNjFFuTjaXaPfVOVXsaASHQ3M91J6VL4MU4Xu1CjnoJNrKwusBmIspRUpqbiqj10rHxq"/>
</div>
<div class="p-sm space-y-2">
<div class="flex items-center gap-2">
<span class="bg-tertiary-fixed text-on-tertiary-fixed-variant px-2 py-0.5 rounded text-[10px] font-bold uppercase">Culture</span>
<span class="text-outline text-xs">Il y a 5h</span>
</div>
<h4 class="font-headline-md text-base leading-tight group-hover:text-primary transition-colors">Exposition d'art : Les talents de demain</h4>
</div>
</div>
<!-- News Card 3 -->
<div class="min-w-[280px] md:min-w-[340px] snap-start group cursor-pointer bg-white rounded-xl shadow-sm hover:shadow-md transition-all">
<div class="aspect-video w-full rounded-t-xl overflow-hidden">
<img alt="Club" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" data-alt="Students collaborating around a laptop in a high-tech school laboratory. The setting is clean, minimalist, and illuminated by modern cool-toned lighting. The image captures a sense of innovation and teamwork, with vibrant blue highlights that align with the platform's primary branding. Professional and high-tempo mood." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBmtK4OkAOQE9xwNRlUiHrgrBrYVcWClVfKf_TL0LmZj-gAamD6GX3TrE5NTbbS_qSJtqykSNTK_WDHQu358Qro586ErumfaIuXMyg2-OiW1RIOC7Pz3Lj6o9Fj0_esnf_UHzoTAaSJcUv5TMsuHMSgURpvabm4xJPVOdOw3Cjn9l-4TrkWWENyt-p7xgRuAIbuHHGcLf_wKT9g2_XjlqzvsIjLf8oL6nhD_Xj2ABwL6oY1bx-GEpKXrmio6nqUSm2_RAdCd72oc8Bz"/>
</div>
<div class="p-sm space-y-2">
<div class="flex items-center gap-2">
<span class="bg-secondary-fixed text-on-secondary-fixed-variant px-2 py-0.5 rounded text-[10px] font-bold uppercase">Tech</span>
<span class="text-outline text-xs">Hier</span>
</div>
<h4 class="font-headline-md text-base leading-tight group-hover:text-primary transition-colors">Nouveau club de robotique : Inscris-toi !</h4>
</div>
</div>
</div>
</section>
<!-- Go Premium Banner -->
<section class="premium-gradient rounded-2xl p-8 relative overflow-hidden text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl active:scale-[0.99] transition-transform cursor-pointer">
<div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -mr-20 -mt-20 blur-3xl"></div>
<div class="absolute bottom-0 left-0 w-32 h-32 bg-primary-container/20 rounded-full -ml-10 -mb-10 blur-2xl"></div>
<div class="relative z-10 space-y-2 text-center md:text-left">
<div class="flex items-center justify-center md:justify-start gap-2">
<span class="material-symbols-outlined text-yellow-400" data-icon="star" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="font-label-md uppercase tracking-widest text-sm">Offre Exclusive</span>
</div>
<h2 class="font-headline-lg">Débloque l'Expérience Premium</h2>
<p class="text-white/80 font-body-md">Sans pub, jeux exclusifs et badges de profil uniques.</p>
</div>
<button class="relative z-10 bg-white text-primary px-8 py-3 rounded-full font-headline-md hover:scale-105 transition-transform shadow-lg whitespace-nowrap">
                Passer à Premium
            </button>
</section>
<!-- Quick Access Bento -->
<section class="grid grid-cols-2 md:grid-cols-4 gap-4">
<div class="bg-white p-6 rounded-xl shadow-sm flex flex-col items-center gap-3 hover:bg-primary-fixed/30 transition-colors cursor-pointer group">
<span class="material-symbols-outlined text-primary text-3xl group-hover:scale-110 transition-transform" data-icon="calendar_month">calendar_month</span>
<span class="font-label-md">Emploi du temps</span>
</div>
<div class="bg-white p-6 rounded-xl shadow-sm flex flex-col items-center gap-3 hover:bg-primary-fixed/30 transition-colors cursor-pointer group">
<span class="material-symbols-outlined text-secondary text-3xl group-hover:scale-110 transition-transform" data-icon="restaurant">restaurant</span>
<span class="font-label-md">Menu Cantine</span>
</div>
<div class="bg-white p-6 rounded-xl shadow-sm flex flex-col items-center gap-3 hover:bg-primary-fixed/30 transition-colors cursor-pointer group">
<span class="material-symbols-outlined text-tertiary text-3xl group-hover:scale-110 transition-transform" data-icon="forum">forum</span>
<span class="font-label-md">Forums</span>
</div>
<div class="bg-white p-6 rounded-xl shadow-sm flex flex-col items-center gap-3 hover:bg-primary-fixed/30 transition-colors cursor-pointer group">
<span class="material-symbols-outlined text-on-surface-variant text-3xl group-hover:scale-110 transition-transform" data-icon="school">school</span>
<span class="font-label-md">Mes Notes</span>
</div>
</section>
</main>
<!-- BottomNavBar -->
<nav class="fixed bottom-0 left-0 w-full h-20 flex justify-around items-center px-4 pb-safe bg-surface-container-low dark:bg-inverse-surface z-50 rounded-t-xl shadow-[0_-4px_24px_rgba(19,27,46,0.06)] dark:shadow-none">
<a class="flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-full px-4 py-1.5 active:scale-90 transition-all duration-200" href="#">
<span class="material-symbols-outlined" data-icon="grid_view" style="font-variation-settings: 'FILL' 1;">grid_view</span>
<span class="font-label-md text-label-md">Hub</span>
</a>
<a class="flex flex-col items-center justify-center text-on-surface-variant dark:text-outline-variant hover:bg-surface-variant dark:hover:bg-on-surface-variant/10 transition-colors rounded-full p-2 active:scale-90 transition-all duration-200" href="#">
<span class="material-symbols-outlined" data-icon="sports_esports">sports_esports</span>
<span class="font-label-md text-label-md">Games</span>
</a>
<a class="flex flex-col items-center justify-center text-on-surface-variant dark:text-outline-variant hover:bg-surface-variant dark:hover:bg-on-surface-variant/10 transition-colors rounded-full p-2 active:scale-90 transition-all duration-200" href="#">
<span class="material-symbols-outlined" data-icon="article">article</span>
<span class="font-label-md text-label-md">News</span>
</a>
<a class="flex flex-col items-center justify-center text-on-surface-variant dark:text-outline-variant hover:bg-surface-variant dark:hover:bg-on-surface-variant/10 transition-colors rounded-full p-2 active:scale-90 transition-all duration-200" href="#">
<span class="material-symbols-outlined" data-icon="star">star</span>
<span class="font-label-md text-label-md">Premium</span>
</a>
</nav>
<script>
        // Simple countdown logic simulation
        function updateCountdown() {
            const mins = document.getElementById('mins');
            if (mins) {
                let current = parseInt(mins.innerText);
                if (current > 0) {
                    mins.innerText = (current - 1).toString().padStart(2, '0');
                } else {
                    mins.innerText = '59';
                }
            }
        }
        setInterval(updateCountdown, 60000);

        // Micro-interaction: Smooth hover lift for cards
        const cards = document.querySelectorAll('.snap-start');
        cards.forEach(card => {
            card.addEventListener('mouseenter', () => {
                card.style.transform = 'translateY(-4px)';
            });
            card.addEventListener('mouseleave', () => {
                card.style.transform = 'translateY(0)';
            });
        });
    </script>
</body></html>